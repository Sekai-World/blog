{
  "name": "tailwind-nextjs-starter-blog",
  "version": "1.5.5",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "cross-env SOCKET=true node ./scripts/next-remote-watch.js ./data",
    "dev": "next dev",
    "build": "next build && node ./scripts/generate-sitemap",
    "serve": "next start",
    "analyze": "cross-env ANALYZE=true next build",
    "lint": "next lint --fix --dir pages --dir components --dir lib --dir layouts --dir scripts",
    "prepare": "husky install"
  },
  "dependencies": {
    "@fontsource/inter": "4.5.2",
    "@mailchimp/mailchimp_marketing": "^3.0.58",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "autoprefixer": "^10.4.21",
    "chalk": "^4.1.2",
    "chokidar": "^3.6.0",
    "commander": "^5.1.0",
    "esbuild": "0.19.12",
    "express": "^4.21.2",
    "github-slugger": "2.0.0",
    "gray-matter": "^4.0.2",
    "image-size": "2.0.2",
    "js-yaml": "4.1.1",
    "mdast-util-to-string": "4.0.0",
    "mdx-bundler": "10.1.1",
    "next": "14.2.32",
    "next-themes": "^0.0.14",
    "postcss": "^8.5.6",
    "preact": "^10.27.2",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "reading-time": "1.3.0",
    "rehype-autolink-headings": "7.1.0",
    "rehype-citation": "2.3.2",
    "rehype-katex": "7.0.1",
    "rehype-preset-minify": "7.0.1",
    "rehype-prism-plus": "2.0.2",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.17",
    "unist-util-visit": "5.1.0"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "14.2.32",
    "@svgr/webpack": "^6.1.2",
    "cross-env": "^7.0.3",
    "dedent": "^0.7.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.32",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-prettier": "^3.3.1",
    "file-loader": "^6.0.0",
    "globby": "11.0.3",
    "husky": "^6.0.0",
    "inquirer": "^8.1.1",
    "lint-staged": "^11.0.0",
    "prettier": "^2.5.1",
    "prettier-plugin-tailwindcss": "^0.1.4",
    "socket.io": "^4.4.0",
    "socket.io-client": "^4.4.0"
  },
  "lint-staged": {
    "*.+(js|jsx|ts|tsx)": [
      "eslint --fix"
    ],
    "*.+(js|jsx|ts|tsx|json|css|md|mdx)": [
      "prettier --write"
    ]
  }
}
